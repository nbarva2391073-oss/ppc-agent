name: Brand Analytics

on:
  schedule:
    # Вівторок 10:00 UTC (13:00 Київ) — після того як Amazon готує дані
    - cron: '0 10 * * 2'
  workflow_dispatch:
    inputs:
      mode:
        description: 'Ринок'
        required: true
        default: 'both'
        type: choice
        options:
          - both
          - usa
          - ca

jobs:
  brand-analytics:
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Run Brand Analytics
        env:
          AMAZON_CLIENT_ID:           ${{ secrets.AMAZON_CLIENT_ID }}
          AMAZON_CLIENT_SECRET:       ${{ secrets.AMAZON_CLIENT_SECRET }}
          AMAZON_REFRESH_TOKEN_USA:   ${{ secrets.AMAZON_REFRESH_TOKEN_USA }}
          AMAZON_REFRESH_TOKEN_CA:    ${{ secrets.AMAZON_REFRESH_TOKEN_CA }}
          ANTHROPIC_API_KEY:          ${{ secrets.ANTHROPIC_API_KEY }}
          GOOGLE_CREDENTIALS_JSON:    ${{ secrets.GOOGLE_CREDENTIALS_JSON }}
          TELEGRAM_BOT_TOKEN:         ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_IDS:          ${{ secrets.TELEGRAM_CHAT_IDS }}
        run: python main_brand_analytics.py
